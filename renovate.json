{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Production deps are bundled into the published dist/ — always require human review.",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Actions are SHA-pinned (helpers:pinGitHubActionDigests); auto-merge only immutable digest re-pins + patch/minor tag moves.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true
    }
  ]
}
