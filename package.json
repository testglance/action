{
  "name": "testglance-action",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TestGlance GitHub Action - Track test suite health over time",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "ncc build src/index.ts --out dist --license licenses.txt",
    "build:debug": "ncc build src/index.ts --out dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:act": "bash scripts/e2e-act.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "node scripts/patch-esm-exports.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,js,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.7.2",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.44.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
